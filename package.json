{
  "name": "skycinema",
  "version": "1.0.0",
  "private": true,
  "description": "SkyCinema — Premium Home Theatre Experience Studio",
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm run dev:client\"",
    "dev:client": "node scripts/wait-for-server.mjs && pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build",
    "start": "pnpm --filter server start",
    "db:setup": "pnpm --filter server db:setup"
  },
  "packageManager": "pnpm@11.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
